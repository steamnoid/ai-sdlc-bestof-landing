{
  "name": "ai-sdlc-bestof-landing",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test --test-concurrency=1 test/",
    "test:collectors": "node --test --test-concurrency=1 test/a_relative_path_and_a_working_directory_do_not_compose.test.mjs test/has_anything_changed_asks_the_live_site.test.mjs test/keep_the_schedule_alive.test.mjs test/skipping_the_build.test.mjs test/the_built_column_is_checked_against_the_tree.test.mjs test/the_code_is_what_the_page_says.test.mjs test/the_documents_are_what_the_project_says.test.mjs test/the_glossary_and_the_code_are_two_sources.test.mjs test/the_glossary_is_what_the_page_says.test.mjs test/the_history_is_the_projects_own.test.mjs test/the_layers_are_what_the_page_says.test.mjs test/the_scripts_reach_the_command_line.test.mjs test/the_silence_is_reported_where_the_workflow_reads_it.test.mjs test/the_state_is_written_once_or_not_at_all.test.mjs test/the_two_test_lists_are_the_two_the_workflow_runs.test.mjs test/what_a_suite_says.test.mjs test/what_github_says_is_never_an_exception.test.mjs test/what_the_page_says.test.mjs test/where_it_came_from_is_read_not_remembered.test.mjs",
    "test:page": "node --test --test-concurrency=1 test/the_page_says_only_what_the_state_says.test.mjs test/the_workflow_publishes_the_page.test.mjs",
    "collect": "node scripts/ask_the_repository.mjs --repository \"${AISDLC_REPOSITORY:-../ai-sdlc-bestof}\" --run-the-suite --github-api \"${GITHUB_API:-https://api.github.com}\"",
    "collect:published": "node scripts/check_out_the_project.mjs && uv sync --all-groups --project build/the-repository && node scripts/ask_the_repository.mjs --repository build/the-repository --ref \"${AISDLC_BRANCH:-main}\" --run-the-suite --github-api \"${GITHUB_API:-https://api.github.com}\"",
    "gate": "./scripts/gate"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}
